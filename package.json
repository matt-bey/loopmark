{
  "name": "loopmark",
  "version": "0.1.0",
  "private": false,
  "description": "A zero-network bookmarklet that converts the Microsoft Loop page you are looking at into clean GitHub-flavored Markdown.",
  "keywords": [
    "microsoft-loop",
    "loop",
    "markdown",
    "bookmarklet",
    "export",
    "gfm",
    "scraper",
    "zero-network"
  ],
  "author": "Matt Bey",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "try": "node scripts/convert-file.mjs",
    "check:no-network": "node scripts/check-no-network.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test && npm run check:no-network && npm run check:fixtures"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
